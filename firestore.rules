rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isCreator() {
      return signedIn()
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    function teacherOwnsClass(classId) {
      return signedIn()
        && exists(/databases/$(database)/documents/classCodes/$(classId))
        && get(/databases/$(database)/documents/classCodes/$(classId)).data.teacherUid == request.auth.uid;
    }

    function classIdCanBeSet(classId) {
      return classId == '' || (classId is string && teacherOwnsClass(classId));
    }

    function usernameIndexMatchesAfter(userId, username) {
      let usernamePath = /databases/$(database)/documents/usernames/$(username);
      let userPath = /databases/$(database)/documents/users/$(userId);
      return username is string
        && existsAfter(usernamePath)
        && existsAfter(userPath)
        && getAfter(usernamePath).data.uid == userId
        && getAfter(usernamePath).data.email == getAfter(userPath).data.email;
    }

    function usernameEntryMatchesProfile(username, userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      return existsAfter(userPath)
        && getAfter(userPath).data.usernameLower == username
        && getAfter(userPath).data.email == request.resource.data.email;
    }

    match /usernames/{username} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && usernameEntryMatchesProfile(username, request.auth.uid);
      // Username changes must update their private index and profile atomically.
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && usernameEntryMatchesProfile(username, request.auth.uid);
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Users may send suggestions and bug reports. Feedback is intentionally
    // readable only by the app creator.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.type in ['suggestion', 'grievance']
        && request.resource.data.page is string
        && (request.resource.data.userId == null || request.resource.data.userId is string)
        && (request.resource.data.userName == null || request.resource.data.userName is string);
      allow read: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    match /reviews/{reviewId} {
      allow read: if isCreator() || resource.data.approvalStatus == 'approved';
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.userName is string
        && request.resource.data.comment is string
        && request.resource.data.comment.size() > 0
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.approvalStatus == 'pending'
        && request.resource.data.approvedBy == null
        && request.resource.data.approvedAt == null;
      allow update: if isCreator()
        && resource.data.approvalStatus == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus', 'approvedBy', 'approvedAt'
        ])
        && request.resource.data.approvalStatus in ['approved', 'rejected']
        && request.resource.data.approvedBy == request.auth.token.email
        && request.resource.data.approvedAt == request.time;
      allow delete: if isCreator();
    }

    match /notifications/{notificationId} {
      allow create: if signedIn()
        && request.resource.data.type == 'review-comment'
        && request.resource.data.recipientEmail == 'boredteacherapp@gmail.com'
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && (request.resource.data.userId == null || request.resource.data.userId == request.auth.uid);
      allow read, update, delete: if signedIn()
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.teacherPro == false
        && request.resource.data.emailVerified == false
        && (!('classId' in request.resource.data) || classIdCanBeSet(request.resource.data.classId))
        && usernameIndexMatchesAfter(userId, request.resource.data.usernameLower);

      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'boredteacherapp@gmail.com'
      );

      allow update: if request.auth != null && (
        request.auth.token.email == 'boredteacherapp@gmail.com' ||
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'username', 'usernameLower', 'avatar', 'theme', 'sound', 'games',
          'xp', 'level', 'coins', 'lastGame', 'loginStreak', 'classId',
          'totalPlaySeconds',
          'emailVerificationCode', 'emailVerificationSentAt', 'emailVerified',
          'welcomeGiftClaimed', 'welcomeGiftId', 'ownedItems', 'lastLogin',
          'isActive', 'updatedAt'
        ]))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['totalPlaySeconds'])
          || (request.resource.data.totalPlaySeconds is number
            && request.resource.data.totalPlaySeconds >= resource.data.get('totalPlaySeconds', 0)))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['classId'])
          || classIdCanBeSet(request.resource.data.classId))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['usernameLower'])
          || usernameIndexMatchesAfter(userId, request.resource.data.usernameLower))
      );

      allow delete: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    match /classCodes/{classCode} {
      allow get: if teacherOwnsClass(classCode);
      allow list: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.teacherUid == request.auth.uid;
    }

    match /leaderboards/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /studentScores/{studentId} {
      allow create, update: if signedIn() && request.auth.uid == studentId
        && teacherOwnsClass(request.resource.data.classId);
      allow get: if signedIn() && (request.auth.uid == studentId
        || teacherOwnsClass(resource.data.classId));
      allow list: if signedIn()
        && teacherOwnsClass(resource.data.classId);
      allow delete: if signedIn() && request.auth.uid == studentId;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /lobbies/{lobbyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
