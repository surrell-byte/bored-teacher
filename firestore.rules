rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userIsInClass(classId) {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.classId == classId;
    }

    function teacherOwnsClass(classId) {
      return signedIn() && get(/databases/$(database)/documents/classCodes/$(classId)).data.teacherUid == request.auth.uid;
    }

    match /usernames/{username} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn() && resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Users may send suggestions and bug reports. Feedback is intentionally
    // readable only by the app creator.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 2000
        && request.resource.data.type in ['suggestion', 'grievance']
        && request.resource.data.page is string
        && (request.resource.data.userId == null || request.resource.data.userId is string)
        && (request.resource.data.userName == null || request.resource.data.userName is string);
      allow read: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
      allow update, delete: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.teacherPro == false
        && request.resource.data.emailVerified == false;

      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        request.auth.token.email == 'boredteacherapp@gmail.com'
      );

      allow update: if request.auth != null && (
        request.auth.token.email == 'boredteacherapp@gmail.com' ||
        (request.auth.uid == userId && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'username', 'usernameLower', 'avatar', 'theme', 'sound', 'games',
          'xp', 'level', 'coins', 'lastGame', 'loginStreak', 'classId',
          'emailVerificationCode', 'emailVerificationSentAt', 'emailVerified',
          'welcomeGiftClaimed', 'welcomeGiftId', 'ownedItems', 'lastLogin',
          'isActive', 'updatedAt'
        ]))
      );

      allow delete: if request.auth != null
        && request.auth.token.email == 'boredteacherapp@gmail.com';
    }

    match /classCodes/{classCode} {
      allow get: if signedIn();
      allow list: if signedIn() && resource.data.teacherUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.teacherUid == request.auth.uid;
    }

    match /leaderboards/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /studentScores/{studentId} {
      allow create, update: if signedIn() && request.auth.uid == studentId
        && (userIsInClass(request.resource.data.classId) || teacherOwnsClass(request.resource.data.classId));
      allow get: if signedIn() && (request.auth.uid == studentId
        || userIsInClass(resource.data.classId)
        || teacherOwnsClass(resource.data.classId));
      allow list: if signedIn()
        && (userIsInClass(resource.data.classId) || teacherOwnsClass(resource.data.classId));
      allow delete: if signedIn() && request.auth.uid == studentId;
    }

    match /leagues/{leagueId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /lobbies/{lobbyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.memberIds is list
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.memberIds is list
        && request.auth.uid in resource.data.memberIds
        && request.auth.uid in request.resource.data.memberIds;
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
